facility-licensing/hermes2-kairos","notes":"First deployment under the October 2024 Kairos Power-Google Master Plant Development Agreement (Google fleet-wide target of up to 500 MW across multiple Kairos plants by 2035). Power is delivered via a Tennessee Valley Authority PPA (announced 2025-08-18) -- the first US utility PPA for an advanced Gen IV reactor -- intended to serve Google data centers in Montgomery County, TN and Jackson County, AL (grid-region delivery, no single named campus). Shares the Heritage Center/ETTP campus with the earlier, smaller non-power-producing Hermes 1 demonstration reactor but sits on a distinct K-33 parcel. Target operation by 2030."},"6152-463cf095":{"plant_id":"6152","name":"Sequoyah","operator":"Tennessee Valley Authority","state":"TN","county":"Hamilton","latitude":35.2267,"longitude":-85.0917,"capacity_mw":2441.0,"status_group":"Operating","statuses":"(OP) Operating","technologies":"Nuclear","energy_sources":"NUC","type":"Nuclear power plant","is_nuclear":true,"source":"EIA-860M June 2026","source_url":"https://www.eia.gov/electricity/data/eia860m/xls/june_generator2026.xlsx"},"7722-d44cadd7":{"plant_id":"7722","name":"Watts Bar Nuclear Plant","operator":"Tennessee Valley Authority","state":"TN","county":"Rhea","latitude":35.6021,"longitude":-84.7895,"capacity_mw":2539.8,"status_group":"Operating","statuses":"(OP) Operating","technologies":"Nuclear","energy_sources":"NUC","type":"Nuclear power plant","is_nuclear":true,"source":"EIA-860M June 2026","source_url":"https://www.eia.gov/electricity/data/eia860m/xls/june_generator2026.xlsx"},"6145-f84ebcee":{"plant_id":"6145","name":"Comanche Peak","operator":"Luminant Generation Company LLC","state":"TX","county":"Somervell","latitude":32.298365,"longitude":-97.78552,"capacity_mw":2430.0,"status_group":"Operating","statuses":"(OP) Operating","technologies":"Nuclear","energy_sources":"NUC","type":"Nuclear power plant","is_nuclear":true,"source":"EIA-860M June 2026","source_url":"https: